{
	"name": "leowla-astro-site",
	"description": "Minimal one-page personal website with Astro on Cloudflare Workers.",
	"dependencies": {
		"@astrojs/cloudflare": "^13.7.0",
		"astro": "^6.4.8",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.7",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.119.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"cf-typegen": "wrangler types",
		"check": "astro check && astro build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"format": "biome format . --write --files-ignore-unknown=true",
		"format:check": "biome format . --files-ignore-unknown=true",
		"lint": "biome lint . --write --files-ignore-unknown=true",
		"lint:check": "biome lint . --files-ignore-unknown=true",
		"preview": "astro build && wrangler dev"
	},
	"type": "module"
}
